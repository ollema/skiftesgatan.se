{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		"paths": {
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "vite.config.ts", "drizzle.config.ts", "playwright.config.ts"],
	"exclude": ["src/service-worker"]
}
