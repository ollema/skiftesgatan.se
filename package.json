{
	"name": "skiftesgatan",
	"private": true,
	"version": "0.0.1",
	"packageManager": "pnpm@10.33.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"test": "vitest run && playwright test",
		"db:push": "pnpx tsx scripts/db/push.ts",
		"db:reset": "pnpx tsx scripts/db/reset-dev.ts",
		"db:studio": "pnpx tsx scripts/db/studio.ts",
		"db:tunnel": "pnpx tsx scripts/db/tunnel.ts",
		"auth:schema": "pnpm dlx auth@latest generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts -y && pnpm format",
		"knip": "knip",
		"icons": "pnpx tsx scripts/generate-icons.ts",
		"email:sync": "pnpx tsx scripts/sync-email-templates.ts"
	},
	"devDependencies": {
		"@clack/prompts": "^1.8.1",
		"@content-collections/core": "^0.15.3",
		"@content-collections/markdown": "^0.1.4",
		"@content-collections/vite": "^0.3.1",
		"@electric-sql/pglite": "^0.4.6",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.2",
		"@vitest/browser-playwright": "^4.1.12",
		"better-auth": "~1.6.33",
		"bits-ui": "^2.20.2",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-better-tailwindcss": "^4.10.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"ical-generator": "^10.2.0",
		"knip": "^6.43.0",
		"playwright": "^1.64.1",
		"postgres": "^3.4.9",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"resend": "^6.34.1",
		"sharp": "^0.34.5",
		"super-sitemap": "^1.0.12",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"svelte-meta-tags": "^4.7.0",
		"svelte-sonner": "^1.2.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"valibot": "^1.5.0",
		"vite": "^8.3.5",
		"vitest": "^4.1.12",
		"vitest-browser-svelte": "^2.2.1"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
