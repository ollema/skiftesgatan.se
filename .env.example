# SQLite database file. Defaults to `.data/skiftesgatan.db` when unset. For
# production, point this at the persistent volume, e.g. `/data/skiftesgatan.db`.
SQLITE_PATH=""

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Resend (email delivery)
RESEND_API_KEY=""
EMAIL_FROM="Skiftesgatan <info@brf.skiftesgatan.se>"

# Contact page (visible to logged-in users only)
CONTACT_MANAGER_NAME=""
CONTACT_MANAGER_PHONE=""
CONTACT_MANAGER_EMAIL=""
